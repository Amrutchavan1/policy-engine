# Query: src/utils/logger.py
# ContextLines: 1

import logging
import json
import re

SENSITIVE_PATTERNS = {
    "email": re.compile(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b'),
    "aadhaar_ssn": re.compile(r'\b(?:\d{4}[ -]?\d{4}[ -]?\d{4}|\d{3}-\d{2}-\d{4})\b'),
    "phone": re.compile(r'\b(?:\+?\d{1,3}[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b'),
    "credit_card": re.compile(r'\b(?:\d[ -]*?){13,16}\b'),
    "token_password": re.compile(r'(?i)(password|token|secret|api_key)\s*[:=]\s*["\']?[^\s"\']+')
}

def mask_sensitive_data(text: str) -> str:
    if not isinstance(text, str):
        return text
    masked = text
    masked = SENSITIVE_PATTERNS["aadhaar_ssn"].sub("[REDACTED_ID]", masked)
    masked = SENSITIVE_PATTERNS["credit_card"].sub("[REDACTED_CARD]", masked)
    masked = SENSITIVE_PATTERNS["email"].sub("[REDACTED_EMAIL]", masked)
    masked = SENSITIVE_PATTERNS["phone"].sub("[REDACTED_PHONE]", masked)
    masked = SENSITIVE_PATTERNS["token_password"].sub(r"\1=[REDACTED_SECRET]", masked)
    return masked

class JsonFormatter(logging.Formatter):
    def format(self, record: logging.LogRecord) -> str:
        log_record = {
            "timestamp": self.formatTime(record, self.datefmt),
            "level": record.levelname,
            "logger": record.name,
            "message": mask_sensitive_data(record.getMessage())
        }
        if hasattr(record, "normalized_arguments"):
            log_record["normalized_arguments"] = {
                k: mask_sensitive_data(str(v)) for k, v in record.normalized_arguments.items()
            }
        if hasattr(record, "content_payload"):
            log_record["content_payload"] = mask_sensitive_data(str(record.content_payload))
        return json.dumps(log_record)
